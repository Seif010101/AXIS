# Copy to .env.local and fill in. Never commit real values.

# MySQL / MariaDB. Local dev: XAMPP MariaDB. Production: the Hostinger database.
# Create the database with: CREATE DATABASE axis_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root@127.0.0.1:3306/axis_dev
DATABASE_POOL_SIZE=5

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Generated account emails are <prefix><id>@<domain>
ALLOWED_EMAIL_DOMAIN=axis.com

# IANA time zone of the schools (day boundary for streaks, daily challenges, star caps).
APP_TIME_ZONE=Asia/Dubai

# Signs short-lived library-proxy tickets — generate with: openssl rand -base64 32
PROXY_TICKET_SECRET=

# AI (Gemini). Model IDs change often, keep them here rather than in code.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.8-flash
AI_MODEL_IMAGE=gemini-3.1-flash-image
# Leave unset (= google) everywhere real. "mock" uses a built-in fake model that never calls
# Google: handy for local development without a key. Never set it in production.
AI_PROVIDER=

# File storage — Backblaze B2 (S3-compatible). Optional until book uploads are used.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=

# Bot check on the sign-in form: Cloudflare Turnstile (hostinger-setup/02-cloudflare-ar.md).
# Leave both empty locally to skip it, or use Cloudflare's always-pass test keys:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 when the domain is proxied through Cloudflare (orange cloud), so per-IP limits see the
# visitor's address (CF-Connecting-IP) instead of a Cloudflare server's.
TRUST_CLOUDFLARE_IP=0

# Optional: Sign in with Microsoft (single tenant)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
