{
  "name": "axis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "test:api": "vitest run --project api",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "create-owner": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/create-owner.ts",
    "seed:dev": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/react": "^4.0.140",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@tanstack/react-query": "^5.104.0",
    "ai": "^7.0.137",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "input-otp": "^1.5.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "katex": "$katex",
    "uuid": "^11.1.1",
    "source-map-js": "^1.2.2",
    "mammoth": {
      "argparse": "^2.0.1"
    }
  }
}
