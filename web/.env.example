# Copy to .env.local and fill in. Never commit real values.
# Use a STAGING Supabase project for development — never production.

# Supabase Postgres — runtime connection (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations / drizzle-kit pull (Session pooler, port 5432)
DATABASE_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Generated account emails are <prefix><id>@<domain>
ALLOWED_EMAIL_DOMAIN=morix.tech

# Signs short-lived library-proxy tickets — generate with: openssl rand -base64 32
PROXY_TICKET_SECRET=

# AI (Gemini). Model IDs change often, keep them here rather than in code.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.8-flash
AI_MODEL_IMAGE=gemini-3.1-flash-image

# File storage — Backblaze B2 (S3-compatible). Optional: falls back to Supabase Storage.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: Sign in with Microsoft (single tenant)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
